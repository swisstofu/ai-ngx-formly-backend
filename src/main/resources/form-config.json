{
  "fields": [
    {
      "key": "firstName",
      "type": "input",
      "props": {
        "label": "Prénom",
        "placeholder": "Entrez votre prénom",
        "required": true,
        "minLength": 4,
        "pattern": "^[a-zA-ZÀ-ÿ\\s'-]+$"
      },
      "validation": {
        "messages": {
          "pattern": "Seules les lettres, espaces, tirets et apostrophes sont autorisés",
          "minLength": "Le prénom doit contenir au moins 4 caractères",
          "required": "Le prénom est requis"
        }
      }
    },
    {
      "key": "lastName",
      "type": "input",
      "props": {
        "label": "Nom",
        "placeholder": "Entrez votre nom",
        "required": true,
        "minLength": 4,
        "pattern": "^[a-zA-ZÀ-ÿ\\s'-]+$"
      },
      "validation": {
        "messages": {
          "pattern": "Seules les lettres, espaces, tirets et apostrophes sont autorisés",
          "minLength": "Le nom doit contenir au moins 4 caractères",
          "required": "Le nom est requis"
        }
      }
    },
    {
      "key": "email",
      "type": "input",
      "props": {
        "label": "Email",
        "placeholder": "Entrez votre email",
        "type": "email",
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "validation": {
        "messages": {
          "pattern": "Veuillez entrer une adresse email valide",
          "required": "L'email est requis"
        }
      }
    },
    {
      "key": "country",
      "type": "select",
      "props": {
        "label": "Pays",
        "placeholder": "Sélectionnez un pays",
        "required": true,
        "options": [
          { "label": "États-Unis", "value": "us" },
          { "label": "Canada", "value": "ca" },
          { "label": "Royaume-Uni", "value": "uk" },
          { "label": "Allemagne", "value": "de" },
          { "label": "France", "value": "fr" }
        ]
      },
      "validation": {
        "messages": {
          "required": "Veuillez sélectionner un pays"
        }
      }
    },
    {
      "key": "state",
      "type": "select",
      "props": {
        "label": "État/Province",
        "placeholder": "Sélectionnez un état",
        "options": [
          { "label": "Californie", "value": "ca" },
          { "label": "New York", "value": "ny" },
          { "label": "Texas", "value": "tx" },
          { "label": "Floride", "value": "fl" }
        ]
      },
      "expressions": {
        "hide": {
          "jsonLogic": {
            "!": {
              "in": [{ "var": "model.country" }, ["us", "ca"]]
            }
          }
        }
      }
    },
    {
      "key": "age",
      "type": "input",
      "props": {
        "label": "Âge",
        "placeholder": "Entrez votre âge",
        "type": "number",
        "min": 0,
        "max": 120
      },
      "validation": {
        "messages": {
          "required": "L'âge est requis pour les résidents américains",
          "min": "L'âge doit être au moins 0",
          "max": "L'âge doit être inférieur à 120"
        }
      },
      "expressions": {
        "props.required": {
          "jsonLogic": {
            "===": [{ "var": "model.country" }, "us"]
          }
        }
      }
    },
    {
      "key": "hasLicense",
      "type": "checkbox",
      "props": {
        "label": "Avez-vous un permis de conduire ?"
      },
      "expressions": {
        "hide": {
          "jsonLogic": {
            "<": [{ "var": "model.age" }, 16]
          }
        }
      }
    },
    {
      "key": "licenseNumber",
      "type": "input",
      "props": {
        "label": "Numéro de permis",
        "placeholder": "Entrez votre numéro de permis",
        "pattern": "^[A-Z0-9]{6,12}$"
      },
      "validation": {
        "messages": {
          "pattern": "Le numéro de permis doit contenir 6 à 12 lettres majuscules ou chiffres",
          "required": "Le numéro de permis est requis"
        }
      },
      "expressions": {
        "hide": {
          "jsonLogic": {
            "!": { "var": "model.hasLicense" }
          }
        },
        "props.required": {
          "jsonLogic": {
            "==": [{ "var": "model.hasLicense" }, true]
          }
        }
      }
    },
    {
      "key": "employmentStatus",
      "type": "select",
      "props": {
        "label": "Statut d'emploi",
        "placeholder": "Sélectionnez votre statut d'emploi",
        "options": [
          { "label": "Employé", "value": "employed" },
          { "label": "Travailleur indépendant", "value": "self-employed" },
          { "label": "Sans emploi", "value": "unemployed" },
          { "label": "Étudiant", "value": "student" },
          { "label": "Retraité", "value": "retired" }
        ]
      },
      "expressions": {
        "props.disabled": {
          "jsonLogic": {
            "<": [{ "var": "model.age" }, 18]
          }
        }
      }
    },
    {
      "key": "companyName",
      "type": "input",
      "props": {
        "label": "Nom de l'entreprise",
        "placeholder": "Entrez le nom de l'entreprise",
        "minLength": 2
      },
      "validation": {
        "messages": {
          "required": "Le nom de l'entreprise est requis",
          "minLength": "Le nom de l'entreprise doit contenir au moins 2 caractères"
        }
      },
      "expressions": {
        "hide": {
          "jsonLogic": {
            "!": {
              "in": [
                { "var": "model.employmentStatus" },
                ["employed", "self-employed"]
              ]
            }
          }
        },
        "props.required": {
          "jsonLogic": {
            "in": [
              { "var": "model.employmentStatus" },
              ["employed", "self-employed"]
            ]
          }
        }
      }
    },
    {
      "key": "annualIncome",
      "type": "input",
      "props": {
        "label": "Revenu annuel",
        "placeholder": "Entrez votre revenu annuel",
        "type": "number",
        "min": 0
      },
      "validation": {
        "messages": {
          "required": "Le revenu annuel est requis",
          "min": "Le revenu annuel doit être au moins 0"
        }
      },
      "expressions": {
        "hide": {
          "jsonLogic": {
            "!": {
              "in": [
                { "var": "model.employmentStatus" },
                ["employed", "self-employed", "retired"]
              ]
            }
          }
        },
        "props.required": {
          "jsonLogic": {
            "and": [
              {
                "in": [
                  { "var": "model.employmentStatus" },
                  ["employed", "self-employed", "retired"]
                ]
              },
              { ">=": [{ "var": "model.age" }, 18] }
            ]
          }
        }
      }
    },
    {
      "key": "comments",
      "type": "textarea",
      "props": {
        "label": "Commentaires supplémentaires",
        "placeholder": "Entrez toute information supplémentaire",
        "rows": 4
      }
    }
  ]
}

